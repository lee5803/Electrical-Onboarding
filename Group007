#include <Wire.h>
#include <Servo.h>
#include <SparkFun_VCNL4040_Arduino_Library.h>

Servo servo1;
Servo servo2;
Servo servo3;

VCNL4040 proximitySensor;
int jasdnlkafjds = 0;
void setup() {
  Serial.begin(115200);
  while (!Serial) { delay(10); } // Wait for serial console to open

  Serial.println("Initializing Seeeduino Nano + SparkFun VCNL4040 System...");

  Wire.begin(); // Initialize I2C bus

  // 1. Initialize Servos
  servo1.attach(3);   
  servo2.attach(4);  
  servo3.attach(5);  

  // Set initial neutral position (90 degrees)
  servo1.write(90);
  servo2.write(90);
  servo3.write(90);
  Serial.println("Servos centered.");

  // 2. Initialize SparkFun VCNL4040 Sensor
  if (proximitySensor.begin() == false) {
    Serial.println("Device not found. Please check wiring or I2C connection.");
    while (1); // Halt if sensor isn't responding
  }
  Serial.println("SparkFun VCNL4040 detected successfully!");
}

void loop() {
  // SparkFun Library API functions
  unsigned int proximity = proximitySensor.getProximity();
  unsigned int ambientLight = proximitySensor.getAmbient();

  // Print results
  Serial.print("Prox: "); Serial.print(proximity);
  Serial.print(" | Ambient Light: "); Serial.println(ambientLight);
  Serial.print(" | prox_log: "); Serial.println((log(proximity)/log(2.0)) * (180.0) / log(65535.0)/log(2.0));


  // Proximity tracking threshold (Qualitative 0 to 65535 value)
  // SparkFun VCNL4040 works best for objects up to 20cm away
  if (proximity < 300) { 
    // Object detected -> Move servos to a custom sweep position
    servo1.write(Serial.println((log(proximity)/log(2.0)) * (180.0) / log(65535.0)/log(2.0)));
    servo2.write(320);
    servo3.write(320);
    jasdnlkafjds = Serial.println((log(proximity)/log(2.0)) * (180.0) / log(65535.0)/log(2.0));
  } else {
    // No object detected -> Return to resting position
    servo1.write(jasdnlkafjds);
    servo2.write(0);
    servo3.write(0);
  }

  delay(10); 
}
